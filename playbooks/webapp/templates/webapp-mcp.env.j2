{{ ansible_managed | comment }}
LINUX_MCP_TRANSPORT=http
LINUX_MCP_HOST=0.0.0.0
LINUX_MCP_PORT=8443
LINUX_MCP_BASE_URL=https://webapp-mcp.webapp-vms.svc:8443
LINUX_MCP_HOST_MODE=local-only
LINUX_MCP_TOOLSET=fixed
LINUX_MCP_POLICY_PATH=/etc/webapp-mcp/policy.yaml
LINUX_MCP_TLS_CERT=/etc/webapp-mcp/tls.crt
LINUX_MCP_TLS_KEY=/etc/webapp-mcp/tls.key
LINUX_MCP_ALLOWED_LOG_PATHS=/var/log/nginx/error.log,/var/log/nginx/access.log,/var/log/audit/audit.log
LINUX_MCP_COMMAND_TIMEOUT=10
LINUX_MCP_LOG_DIR=/var/log/webapp-mcp
LINUX_MCP_MAX_FILE_READ_BYTES=65536
LINUX_MCP_AUTH__PROVIDER=jwt
LINUX_MCP_AUTH__JWT__ISSUER={{ webapp_mcp_material_lookup.jwt_issuer }}
LINUX_MCP_AUTH__JWT__JWKS_URI={{ webapp_mcp_material_lookup.jwt_jwks_uri }}
LINUX_MCP_AUTH__JWT__AUDIENCE=webapp-mcp
SSL_CERT_FILE=/etc/webapp-mcp/jwt-ca.crt
